import { Theme } from "theme.slint";

// Single adapter between glyph data and the primitives, the counterpart of
// web/src/primitives/icons.tsx. That file re-exports two icon libraries;
// Slint has no icon package, so the paths are inlined here.
//
// Two sets, drawn on one 24-unit grid:
//   - stroked   general UI chrome, lucide's shapes at lucide's 1.9 weight
//   - solid     alignment and transform glyphs, the rail-and-block shapes a
//               dense inspector wants (Radix draws these on a 15-unit grid)
//
// `commands` may only be set in a binding and never read back, so each glyph
// is its own instance with a literal string rather than one lookup table.
export enum Glyph {
    none,
    plus,
    minus,
    close,
    check,
    chevron-down,
    chevron-right,
    sparkle,
    eye,
    lock,
    frame,
    copy,
    flip-h,
    flip-v,
    keyframe,
    angle,
    align-left,
    align-center-x,
    align-right,
    align-top,
    align-center-y,
    align-bottom,
    distribute,
    fit,
    film,
    music,
    image,
    import,
    transition,
    slot,
    settings,
    sun,
    moon,
    export,
    chevron-up,
    search,
    // the timeline tray and its lane headers
    pointer,
    razor,
    split,
    merge,
    trash,
    magnet,
    waveform,
    eye-off,
    volume,
    volume-off,
    unlock,
    // the monitor's transport
    play,
    pause,
    step-back,
    step-forward,
    skip-back,
    skip-forward,
}

component Stroked inherits Path {
    in property <length> size: 14px;
    in property <brush> tint: Theme.fg-muted;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    // lucide draws at stroke-width 1.9 on a 24 grid; hold that ratio at any size
    stroke-width: root.size * 1.9 / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// The alignment glyphs stay on Radix's 15-unit grid. Drawing them on the 24
// grid puts a 4-unit bar below 2.5px at the 14px size an inspector uses, and
// the rail and blocks smear into one shape.
component Solid inherits Path {
    in property <length> size: 14px;
    in property <brush> tint: Theme.fg-muted;
    width: root.size;
    height: root.size;
    viewbox-width: 15;
    viewbox-height: 15;
    fill: root.tint;
    fill-rule: evenodd;
}

component Filled inherits Path {
    in property <length> size: 14px;
    in property <brush> tint: Theme.fg-muted;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.tint;
}

export component Icon inherits Rectangle {
    in property <Glyph> glyph;
    in property <length> size: 14px;
    in property <brush> tint: Theme.fg-muted;
    /// solidifies the keyframe diamond, the way `filled` does on KeyframeIcon
    in property <bool> filled;

    width: root.size;
    height: root.size;

    if root.glyph == Glyph.plus: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 5 12 L 19 12 M 12 5 L 12 19";
    }
    if root.glyph == Glyph.minus: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 5 12 L 19 12";
    }
    if root.glyph == Glyph.close: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 18 6 L 6 18 M 6 6 L 18 18";
    }
    if root.glyph == Glyph.check: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 20 6 L 9 17 L 4 12";
    }
    if root.glyph == Glyph.chevron-down: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 6 9 L 12 15 L 18 9";
    }
    if root.glyph == Glyph.chevron-right: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 9 6 L 15 12 L 9 18";
    }
    if root.glyph == Glyph.chevron-up: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 6 15 L 12 9 L 18 15";
    }
    if root.glyph == Glyph.search: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 21 21 L 16.65 16.65"
            + " M 19 11 A 8 8 0 0 1 3 11 A 8 8 0 0 1 19 11 Z";
    }
    if root.glyph == Glyph.sparkle: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 11 4 L 12.5 9.5 L 18 11 L 12.5 12.5 L 11 18 L 9.5 12.5 L 4 11 L 9.5 9.5 Z"
            + " M 18.5 3 L 19.2 4.8 L 21 5.5 L 19.2 6.2 L 18.5 8 L 17.8 6.2 L 16 5.5 L 17.8 4.8 Z";
    }
    if root.glyph == Glyph.eye: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 2 12 C 4.5 7 8 5 12 5 C 16 5 19.5 7 22 12"
            + " C 19.5 17 16 19 12 19 C 8 19 4.5 17 2 12 Z"
            + " M 15 12 A 3 3 0 0 1 9 12 A 3 3 0 0 1 15 12 Z";
    }
    if root.glyph == Glyph.lock: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 5 11 L 19 11 L 19 21 L 5 21 Z M 8 11 L 8 7 A 4 4 0 0 1 16 7 L 16 11";
    }
    if root.glyph == Glyph.frame: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 4 8 L 20 8 M 4 16 L 20 16 M 8 4 L 8 20 M 16 4 L 16 20";
    }
    if root.glyph == Glyph.copy: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 8 8 L 20 8 L 20 20 L 8 20 Z M 16 4 L 4 4 L 4 16";
    }
    if root.glyph == Glyph.flip-h: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 12 3 L 12 21 M 8 7 L 3 12 L 8 17 Z M 16 7 L 21 12 L 16 17 Z";
    }
    if root.glyph == Glyph.flip-v: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 3 12 L 21 12 M 7 8 L 12 3 L 17 8 Z M 7 16 L 12 21 L 17 16 Z";
    }
    if root.glyph == Glyph.keyframe: Stroked {
        size: root.size; tint: root.tint;
        fill: root.filled ? root.tint : Colors.transparent;
        commands: "M 12 3 L 21 12 L 12 21 L 3 12 Z";
    }
    if root.glyph == Glyph.angle: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 4 20 L 20 20 M 4 20 L 17 7 M 14 20 A 10 10 0 0 0 11 12.9";
    }

    // The three media kinds, drawn as the bin's cards and the timeline's clips
    // both label them. Circles are two half-arcs because a path has no circle
    // command, the same construction the eye above uses.
    // Title-bar controls: the lucide gear, sun and moon, and an upload-shaped
    // export arrow.
    if root.glyph == Glyph.settings: Stroked {
        size: root.size; tint: root.tint;
        commands: "M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
            + " M 15 12 A 3 3 0 0 1 9 12 A 3 3 0 0 1 15 12 Z";
    }
    if root.glyph == Glyph.sun: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 12 2 L 12 4 M 12 20 L 12 22 M 4.93 4.93 L 6.34 6.34"
            + " M 17.66 17.66 L 19.07 19.07 M 2 12 L 4 12 M 20 12 L 22 12"
            + " M 6.34 17.66 L 4.93 19.07 M 19.07 4.93 L 17.66 6.34"
            + " M 16 12 A 4 4 0 0 1 8 12 A 4 4 0 0 1 16 12 Z";
    }
    if root.glyph == Glyph.moon: Stroked {
        size: root.size; tint: root.tint;
        commands: "M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z";
    }
    if root.glyph == Glyph.export: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 21 15 L 21 19 A 2 2 0 0 1 19 21 L 5 21 A 2 2 0 0 1 3 19 L 3 15"
            + " M 17 8 L 12 3 L 7 8 M 12 3 L 12 15";
    }

    // A frame split on the diagonal, for the transitions catalogue.
    if root.glyph == Glyph.transition: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 6 4 L 18 4 A 2 2 0 0 1 20 6 L 20 18 A 2 2 0 0 1 18 20"
            + " L 6 20 A 2 2 0 0 1 4 18 L 4 6 A 2 2 0 0 1 6 4 Z"
            + " M 4.8 19.2 L 19.2 4.8";
    }
    // A placeholder box with a plus — the frame a template fills in later.
    // The reference dashes the box; a Slint Path has no dash array, so it
    // stays solid.
    if root.glyph == Glyph.slot: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 6 5.5 L 18 5.5 A 2.5 2.5 0 0 1 20.5 8 L 20.5 16"
            + " A 2.5 2.5 0 0 1 18 18.5 L 6 18.5 A 2.5 2.5 0 0 1 3.5 16"
            + " L 3.5 8 A 2.5 2.5 0 0 1 6 5.5 Z"
            + " M 12 9.5 L 12 14.5 M 9.5 12 L 14.5 12";
    }

    if root.glyph == Glyph.film: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 5 4 L 19 4 A 2 2 0 0 1 21 6 L 21 18 A 2 2 0 0 1 19 20"
            + " L 5 20 A 2 2 0 0 1 3 18 L 3 6 A 2 2 0 0 1 5 4 Z"
            + " M 7 4 L 7 20 M 17 4 L 17 20 M 3 12 L 21 12";
    }
    if root.glyph == Glyph.music: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 9 18 L 9 5 L 20 3 L 20 16"
            + " M 9 18 A 3 3 0 0 1 3 18 A 3 3 0 0 1 9 18 Z"
            + " M 20 16 A 3 3 0 0 1 14 16 A 3 3 0 0 1 20 16 Z";
    }
    if root.glyph == Glyph.image: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 5 4 L 19 4 A 2 2 0 0 1 21 6 L 21 18 A 2 2 0 0 1 19 20"
            + " L 5 20 A 2 2 0 0 1 3 18 L 3 6 A 2 2 0 0 1 5 4 Z"
            + " M 10 9.5 A 1.5 1.5 0 0 1 7 9.5 A 1.5 1.5 0 0 1 10 9.5 Z"
            + " M 3 17 L 8 13 L 12 16 L 15 14 L 21 19";
    }
    // Arrow down into a tray — import, as opposed to `plus`, which adds
    // something the app already has.
    if root.glyph == Glyph.import: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 12 3 L 12 15 M 7 10 L 12 15 L 17 10"
            + " M 3 15 L 3 19 A 2 2 0 0 0 5 21 L 19 21 A 2 2 0 0 0 21 19 L 21 15";
    }

    // Whole-unit coordinates only: rendered at 15px these land on pixel
    // boundaries, and a 1-unit rail beside a 3-unit block stays legible instead
    // of dissolving into antialiasing.
    if root.glyph == Glyph.align-left: Solid {
        size: root.size; tint: root.tint;
        commands: "M 1 1 L 2 1 L 2 14 L 1 14 Z M 4 3 L 13 3 L 13 6 L 4 6 Z"
            + " M 4 9 L 10 9 L 10 12 L 4 12 Z";
    }
    if root.glyph == Glyph.align-center-x: Solid {
        size: root.size; tint: root.tint;
        commands: "M 7 1 L 8 1 L 8 14 L 7 14 Z M 2 3 L 13 3 L 13 6 L 2 6 Z"
            + " M 4 9 L 11 9 L 11 12 L 4 12 Z";
    }
    if root.glyph == Glyph.align-right: Solid {
        size: root.size; tint: root.tint;
        commands: "M 13 1 L 14 1 L 14 14 L 13 14 Z M 2 3 L 11 3 L 11 6 L 2 6 Z"
            + " M 5 9 L 11 9 L 11 12 L 5 12 Z";
    }
    if root.glyph == Glyph.align-top: Solid {
        size: root.size; tint: root.tint;
        commands: "M 1 1 L 14 1 L 14 2 L 1 2 Z M 3 4 L 6 4 L 6 13 L 3 13 Z"
            + " M 9 4 L 12 4 L 12 10 L 9 10 Z";
    }
    if root.glyph == Glyph.align-center-y: Solid {
        size: root.size; tint: root.tint;
        commands: "M 1 7 L 14 7 L 14 8 L 1 8 Z M 3 2 L 6 2 L 6 13 L 3 13 Z"
            + " M 9 4 L 12 4 L 12 11 L 9 11 Z";
    }
    if root.glyph == Glyph.align-bottom: Solid {
        size: root.size; tint: root.tint;
        commands: "M 1 13 L 14 13 L 14 14 L 1 14 Z M 3 2 L 6 2 L 6 11 L 3 11 Z"
            + " M 9 5 L 12 5 L 12 11 L 9 11 Z";
    }
    if root.glyph == Glyph.distribute: Solid {
        size: root.size; tint: root.tint;
        commands: "M 1 1 L 2 1 L 2 14 L 1 14 Z M 13 1 L 14 1 L 14 14 L 13 14 Z"
            + " M 4 4 L 7 4 L 7 11 L 4 11 Z M 9 4 L 12 4 L 12 11 L 9 11 Z";
    }
    if root.glyph == Glyph.fit: Solid {
        size: root.size; tint: root.tint;
        commands: "M 1 3 L 14 3 L 14 12 L 1 12 Z M 2 4 L 13 4 L 13 11 L 2 11 Z";
    }

    // ── the timeline ────────────────────────────────────────────────────────

    // The select arrow. Closed and filled rather than stroked: at 14px a
    // stroked arrowhead is mostly outline and reads as an outline of a cursor
    // instead of a cursor.
    if root.glyph == Glyph.pointer: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 4 3 L 11 20 L 13.5 13.5 L 20 11 Z";
    }
    // Two blades crossing above their pivots — the razor every NLE draws.
    // The circles are arcs in the command string; Slint's parser takes the SVG
    // `A` form, so a full circle is two half-arcs back to back.
    if root.glyph == Glyph.razor: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 3.5 18 A 2.5 2.5 0 1 0 8.5 18 A 2.5 2.5 0 1 0 3.5 18"
            + " M 15.5 18 A 2.5 2.5 0 1 0 20.5 18 A 2.5 2.5 0 1 0 15.5 18"
            + " M 7.8 16.2 L 18 4 M 16.2 16.2 L 6 4";
    }
    // Split: a dashed cut line between two halves pulling apart. Slint has no
    // stroke-dash-array, so the dashes are three separate segments.
    if root.glyph == Glyph.split: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 12 3 L 12 7 M 12 10 L 12 14 M 12 17 L 12 21"
            + " M 8 7 L 5 7 A 2 2 0 0 0 3 9 L 3 15 A 2 2 0 0 0 5 17 L 8 17"
            + " M 16 7 L 19 7 A 2 2 0 0 1 21 9 L 21 15 A 2 2 0 0 1 19 17 L 16 17";
    }
    // Merge: the same two halves, closed onto a solid seam.
    if root.glyph == Glyph.merge: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 12 3 L 12 21"
            + " M 3 7 L 8 7 A 2 2 0 0 1 10 9 L 10 15 A 2 2 0 0 1 8 17 L 3 17"
            + " M 21 7 L 16 7 A 2 2 0 0 0 14 9 L 14 15 A 2 2 0 0 0 16 17 L 21 17";
    }
    if root.glyph == Glyph.trash: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 3 6 L 21 6"
            + " M 8 6 L 8 4 A 1 1 0 0 1 9 3 L 15 3 A 1 1 0 0 1 16 4 L 16 6"
            + " M 19 6 L 19 20 A 2 2 0 0 1 17 22 L 7 22 A 2 2 0 0 1 5 20 L 5 6"
            + " M 10 11 L 10 17 M 14 11 L 14 17";
    }
    if root.glyph == Glyph.magnet: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 6 15 L 6 8 A 6 6 0 0 1 18 8 L 18 15"
            + " M 6 15 A 3 3 0 0 0 12 15 L 12 9"
            + " M 18 15 A 3 3 0 0 1 12 15 L 12 9";
    }
    // The A/V tools mark: a level bar chart, not a waveform trace. Five bars
    // survive being drawn at 14px; a traced wave turns to mush.
    if root.glyph == Glyph.waveform: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 3 12 L 3 13 M 7 8 L 7 16 M 11 5 L 11 19"
            + " M 15 9 L 15 15 M 19 11 L 19 13";
    }
    if root.glyph == Glyph.eye-off: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 10.7 5.1 A 10.9 10.9 0 0 1 12 5 C 18.5 5 22 12 22 12"
            + " A 18 18 0 0 1 19.4 15.5"
            + " M 6.6 6.6 A 18 18 0 0 0 2 12 C 2 12 5.5 19 12 19"
            + " A 10.7 10.7 0 0 0 17.4 17.6"
            + " M 2 2 L 22 22";
    }
    if root.glyph == Glyph.volume: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 11 5 L 6 9 L 3 9 L 3 15 L 6 15 L 11 19 Z"
            + " M 16 8.5 A 4.5 4.5 0 0 1 16 15.5"
            + " M 19 5.5 A 8.5 8.5 0 0 1 19 18.5";
    }
    if root.glyph == Glyph.volume-off: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 11 5 L 6 9 L 3 9 L 3 15 L 6 15 L 11 19 Z"
            + " M 16 9 L 21 15 M 21 9 L 16 15";
    }
    // The same body as `lock` with the shackle swung open, so the pair reads
    // as one control in two states rather than as two different marks.
    if root.glyph == Glyph.unlock: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 5 11 L 19 11 L 19 21 L 5 21 Z M 8 11 L 8 7 A 4 4 0 0 1 16 7";
    }

    // Play and pause are filled, the way the reference passes
    // `fill="currentColor"` to them: at 16px an outlined triangle reads as an
    // outline of a play button rather than as one.
    if root.glyph == Glyph.play: Filled {
        size: root.size; tint: root.tint;
        commands: "M 7 4 L 20 12 L 7 20 Z";
    }
    if root.glyph == Glyph.pause: Filled {
        size: root.size; tint: root.tint;
        commands: "M 7 4 L 11 4 L 11 20 L 7 20 Z M 13 4 L 17 4 L 17 20 L 13 20 Z";
    }
    // The step and skip pairs stay stroked, as lucide draws them — the bar is
    // a line and the wedge is an outline, and filling only the wedge would
    // make the two halves of one mark disagree.
    if root.glyph == Glyph.step-back: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 18 20 L 18 4 M 14 20 L 4 12 L 14 4 Z";
    }
    if root.glyph == Glyph.step-forward: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 6 4 L 6 20 M 10 4 L 20 12 L 10 20 Z";
    }
    if root.glyph == Glyph.skip-back: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 19 20 L 9 12 L 19 4 Z M 5 19 L 5 5";
    }
    if root.glyph == Glyph.skip-forward: Stroked {
        size: root.size; tint: root.tint;
        commands: "M 5 4 L 15 12 L 5 20 Z M 19 5 L 19 19";
    }
}
