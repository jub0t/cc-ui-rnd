// Design tokens, mirrored from web/src/styles/tokens.css so both
// implementations describe the same product rather than drifting apart.
export global Theme {
    // surfaces
    out property <color> panel: #0d0d0d;
    out property <color> page: #08080a;
    out property <color> well: #111111;
    out property <color> raised: #161616;
    out property <color> field: #1f1f1f;
    out property <color> field-hover: #272727;
    out property <color> head: #151515;
    out property <color> line: #232323;
    out property <color> edge: #333333;

    // text
    out property <color> ink: #ededed;
    out property <color> ink-muted: #8b8b8b;
    out property <color> ink-dim: #5c5c5c;

    // accents
    out property <color> accent: #0a84ff;
    out property <color> accent-hover: #3d9bff;
    out property <color> success: #30d158;

    // metrics
    out property <length> control-height: 28px;
    out property <length> gutter: 14px;
    out property <length> gap: 6px;
    out property <length> radius: 7px;
    out property <length> radius-panel: 12px;
    out property <length> text-size: 13px;
    out property <length> text-size-sm: 12px;
}
