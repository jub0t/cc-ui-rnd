// Design tokens, mirrored 1:1 from web/src/styles/tokens.css so both
// implementations describe the same product rather than drifting apart.
// Retheming is a matter of overriding this block.
export global Theme {
    // type
    out property <string> font: "Inter";
    out property <length> fs-sm: 11px;
    out property <length> fs: 12px;
    out property <length> fs-lg: 13px;

    // Renderer compensation, not a design decision.
    //
    // FemtoVG composites glyph coverage without gamma correction, so light text
    // on a dark panel comes out lighter than the identical tokens do in a
    // browser (which corrects for it). The colours and sizes above are mirrored
    // from tokens.css and must stay that way — editing those to chase the look
    // would fork the design from web/ silently, which is the one thing this
    // repo exists to avoid. Weight is the one axis that compensates without
    // touching a shared token, and both faces are already bundled, so it costs
    // nothing at runtime.
    //
    // Reset to 400/500 to remove the compensation. Do that if you build with
    // --features skia, or if FemtoVG ever gains gamma-correct blending —
    // otherwise the text will be over-corrected and read as too heavy.
    //
    // Only small text is compensated: the page heading stays at 600 because at
    // 22px the thinning is not perceptible and there is no Bold face bundled.
    out property <int> weight-body: 500;    // 400 uncompensated
    out property <int> weight-title: 600;   // 500 uncompensated

    // surfaces
    out property <color> panel: #0d0d0d;
    out property <color> raised: #161616;
    out property <color> well: #111111;
    out property <color> field: #1f1f1f;
    out property <color> field-hover: #272727;
    out property <color> field-active: #303030;

    // hairlines
    out property <color> line: #232323;
    out property <color> line-strong: #363636;

    // text
    out property <color> fg: #ededed;
    out property <color> fg-muted: #8b8b8b;
    out property <color> fg-dim: #5c5c5c;

    // accents
    out property <color> accent: #0a84ff;
    out property <color> accent-hover: #3d9bff;
    out property <color> accent-soft: #0a84ff33;  // rgb(10 132 255 / 0.2)
    out property <color> green: #30d158;
    out property <color> on-accent: #ffffff;
    out property <color> on-green: #06210f;

    // meter ramp
    out property <color> meter-low: #34c759;
    out property <color> meter-mid: #ffd60a;
    out property <color> meter-high: #ff453a;

    // radii
    out property <length> r-xs: 3px;
    out property <length> r-sm: 5px;
    out property <length> r: 7px;
    out property <length> r-lg: 12px;

    // metrics
    out property <length> h: 28px;        // standard control height
    out property <length> gap: 6px;
    out property <length> pad: 14px;      // panel horizontal padding
    out property <length> label-w: 62px;

    // page chrome, from web/src/App.css
    out property <color> page: #08080a;
    out property <color> page-fg-muted: #9a9aa2;
}
