import { Theme } from "../theme.slint";
import { EffectData } from "../demo/effects-panel.slint";
import { ColSplitter, RowSplitter } from "splitter.slint";
import { MenuItemData } from "../primitives/context-menu.slint";
import { ConfigPane } from "config-pane.slint";
import { MediaFilter, MediaItemData, MediaPane } from "media-pane.slint";
import { PreviewPane } from "preview-pane.slint";
import { TimelinePane } from "timeline-pane.slint";
import {
    ClipData, ClipField, ClipTextField, DropData, SelectedClipData,
    TimelineTabData, TimelineTool, TrackData, TrackSize,
} from "../timeline/model.slint";

// The editor shell: Media | Preview | Config across the top, Timeline across
// the full width below, every edge draggable.
//
// Positioned by hand rather than with nested layouts. A layout would give the
// same picture, but the splitters need the one thing a layout hides — the
// pixel the boundary is currently at — and a HorizontalLayout inside a
// VerticalLayout has no name for "the edge between the second and third
// child". Four rectangles and two divisions are cheaper than fighting that.
//
// Sizes are stored as shares of the usable box, not pixels, so a window resize
// keeps the proportions the user dragged instead of dumping every pixel into
// one pane.
export component Workspace inherits Rectangle {
    // forwarded to the library column
    in property <[MediaItemData]> media;
    in property <int> media-count-all;
    in property <int> media-count-video;
    in property <int> media-count-audio;
    in property <int> media-count-images;
    in property <int> media-selected-count;
    in property <bool> importing;

    callback import-media();
    callback media-filter-changed(filter: MediaFilter);
    callback media-select(id: int, additive: bool);
    callback media-clear-selection();
    callback media-remove(id: int);
    callback media-remove-selected();
    callback media-activate(id: int);

    // library catalogue pages
    callback library-add-text();
    callback library-apply-effect(effect-id: string);
    callback library-apply-transition(transition-id: string);
    callback library-apply-filter(filter-id: string, label: string);
    callback library-save-template();

    // forwarded to the inspector column
    in property <SelectedClipData> selected-clip;
    callback clip-set(field: ClipField, value: float);
    callback clip-set-text(field: ClipTextField, value: string);
    callback clip-set-colour(field: ClipTextField, value: color);
    callback clip-commit();

    in property <[EffectData]> video-effects;
    in property <[EffectData]> audio-effects;
    in property <float> level;
    in property <float> peak;
    out property <bool> muted: config.muted;
    out property <bool> meter-hovered: config.meter-hovered;
    callback add-effect(audio: bool);
    callback remove-effect(id: int);

    // forwarded to the monitor
    in property <int> output-width;
    in property <int> output-height;
    in property <int> ratio-index;
    in property <int> quality-index;
    in property <bool> playing;
    in property <bool> has-picture;
    in property <string> preview-clip-name;
    in property <float> preview-duration;

    callback play-toggled();
    callback seek(seconds: float);
    callback step-frames(frames: float);
    callback ratio-changed(index: int);
    callback quality-changed(index: int);

    // forwarded to the timeline
    in property <[TimelineTabData]> timeline-tabs;
    in property <int> timeline-current-tab;
    in property <[TrackData]> tracks;
    in property <[ClipData]> clips;
    in property <TimelineTool> tool;
    in property <bool> snap;
    in property <int> selected-count;
    in property <string> merge-blocked-because;
    in property <bool> has-av-tools;
    in property <float> playhead;
    in property <float> frame-rate;
    in property <float> scroll-left;
    in property <float> seconds-per-pixel;

    callback tab-selected(index: int);
    callback tab-renamed(index: int, name: string);
    callback tab-close-requested(index: int);
    callback tab-added();
    callback tool-changed(tool: TimelineTool);
    callback snap-changed(snap: bool);
    callback split();
    callback merge();
    callback delete-selected();
    callback av-tools();
    in property <[MenuItemData]> av-items;
    in property <length> av-height;
    in property <int> av-token;
    callback av-selected(id: string);
    callback add-track();
    callback zoom-to-fit(width: length);
    callback zoom(factor: float, anchor-seconds: float);
    callback scrubbed(seconds: float);
    callback clip-pressed(id: string, additive: bool, edge: int);
    callback clip-dragged(seconds: float, pixels: length);
    callback clip-released();
    callback razored(id: string, seconds: float);
    in property <[MenuItemData]> menu-items;
    in property <length> menu-height;
    in property <int> menu-token;
    callback clip-context(id: string);
    callback menu-selected(id: string);

    callback band-selected(from-seconds: float, to-seconds: float,
        from-y: length, to-y: length, additive: bool);
    callback scrolled(seconds: float);

    /// A library card dragged onto the lanes. See DropData in the timeline's
    /// model: the ghost is Rust's answer to the hover, not the panel's guess.
    in property <DropData> drop;
    callback drag-hovered(payload: string, seconds: float, y: length);
    callback dropped(payload: string, seconds: float, y: length);
    callback track-flag-changed(index: int, visible: bool, muted: bool, locked: bool);
    callback track-sized(index: int, size: TrackSize);
    callback track-removed(index: int);
    callback track-renamed(index: int, name: string);

    // One value for the margin and the gutters, so the border around the
    // workspace and the space between any two panes read as the same gap.
    // 8px, matching the reference exactly: its resizers are `w-2`/`h-2` and
    // the layout around them is `p-2`, which is the same single value said
    // twice. 12px here read as loose beside it.
    in property <length> gap: 8px;
    /// smallest a column may be dragged to
    in property <length> min-col: 220px;
    /// Config used to floor at 320px, because the demo panels it carried
    /// bottomed out at the bezier editor's own 200px minimum. Those are gone —
    /// the pane now holds Details, Adjust, Text and the preset stacks, whose
    /// rows all reflow — so the floor comes down under the reference's own
    /// 300px default, which the old one would not even have allowed.
    in property <length> min-config: 280px;
    /// smallest a row may be dragged to
    in property <length> min-row: 140px;

    // Shares of the usable box. The middle column and the bottom row are the
    // remainder, so the three columns always sum to the width exactly — no
    // rounding crumb left over at the right edge.
    //
    // The reference opens at 420px of library and 300px of inspector, which at
    // this window's preferred 1400px is 0.31 and 0.22 of the usable track. The
    // library is the wider of the two because it is a grid of cards and the
    // inspector is a column of rows: one needs width to show anything at all,
    // the other only needs enough not to elide its labels.
    in-out property <float> media-share: 0.31;
    in-out property <float> config-share: 0.22;
    // The reference opens with 340px of timeline, which at this window's
    // preferred 900px is a fraction under 0.6 of the usable track. 0.66 left
    // the lanes cramped enough that a four-track stack needed scrolling before
    // anything had been added to it.
    in-out property <float> top-share: 0.6;

    // Usable box: the pane widths and heights, with the margins and gutters
    // already taken out. Four gaps across (two margins, two gutters), three
    // down (two margins, one gutter).
    property <length> track-w: Math.max(1px, root.width - 4 * root.gap);
    property <length> track-h: Math.max(1px, root.height - 3 * root.gap);

    // The minimums are enforced here and not only on the drag, because a share
    // is a share: shrink the window far enough and a column that was legal
    // when it was dragged is not any more. Preview and Timeline take the
    // remainder, so they are the ones that give — which is the right way
    // round, they are the two that stay useful at any size.
    property <length> media-w: Math.max(root.min-col, root.track-w * root.media-share);
    property <length> config-w: Math.max(root.min-config, root.track-w * root.config-share);
    property <length> preview-w: Math.max(0px, root.track-w - root.media-w - root.config-w);
    property <length> top-h: Math.min(Math.max(root.min-row, root.track-h * root.top-share),
        Math.max(root.min-row, root.track-h - root.min-row));
    property <length> timeline-h: root.track-h - root.top-h;

    // A drag is one pointer, so one slot holds whichever share went down.
    property <float> press-share;

    // Math.clamp with the range guarded: on a window too small to honour the
    // minimums the range inverts, and an unguarded clamp would snap the pane
    // to the wrong end of it.
    pure function fit(value: float, low: float, high: float) -> float {
        return Math.min(Math.max(value, low), Math.max(low, high));
    }

    background: Theme.page;

    MediaPane {
        x: root.gap;
        y: root.gap;
        width: root.media-w;
        height: root.top-h;

        items: root.media;
        count-all: root.media-count-all;
        count-video: root.media-count-video;
        count-audio: root.media-count-audio;
        count-images: root.media-count-images;
        selected-count: root.media-selected-count;
        importing: root.importing;

        import-media => { root.import-media(); }
        filter-changed(filter) => { root.media-filter-changed(filter); }
        select(id, additive) => { root.media-select(id, additive); }
        clear-selection => { root.media-clear-selection(); }
        remove(id) => { root.media-remove(id); }
        remove-selected => { root.media-remove-selected(); }
        activate(id) => { root.media-activate(id); }

        add-text => { root.library-add-text(); }
        apply-effect(id) => { root.library-apply-effect(id); }
        apply-transition(id) => { root.library-apply-transition(id); }
        apply-filter(id, label) => { root.library-apply-filter(id, label); }
        save-template => { root.library-save-template(); }
    }

    PreviewPane {
        x: 2 * root.gap + root.media-w;
        y: root.gap;
        width: root.preview-w;
        height: root.top-h;

        output-width: root.output-width;
        output-height: root.output-height;
        frame-rate: root.frame-rate;
        ratio-index: root.ratio-index;
        quality-index: root.quality-index;
        playhead: root.playhead;
        duration: root.preview-duration;
        playing: root.playing;
        has-picture: root.has-picture;
        clip-name: root.preview-clip-name;

        play-toggled => { root.play-toggled(); }
        seek(seconds) => { root.seek(seconds); }
        step(frames) => { root.step-frames(frames); }
        ratio-changed(index) => { root.ratio-changed(index); }
        quality-changed(index) => { root.quality-changed(index); }
    }

    config := ConfigPane {
        x: 3 * root.gap + root.media-w + root.preview-w;
        y: root.gap;
        width: root.config-w;
        height: root.top-h;

        video-effects: root.video-effects;
        audio-effects: root.audio-effects;
        level: root.level;
        peak: root.peak;
        add-effect(audio) => { root.add-effect(audio); }
        remove-effect(id) => { root.remove-effect(id); }

        selected: root.selected-clip;
        clip-set(field, value) => { root.clip-set(field, value); }
        clip-set-text(field, value) => { root.clip-set-text(field, value); }
        clip-set-colour(field, value) => { root.clip-set-colour(field, value); }
        clip-commit => { root.clip-commit(); }
    }

    TimelinePane {
        x: root.gap;
        y: 2 * root.gap + root.top-h;
        width: root.width - 2 * root.gap;
        height: root.timeline-h;

        tabs: root.timeline-tabs;
        current-tab: root.timeline-current-tab;
        tracks: root.tracks;
        clips: root.clips;
        tool: root.tool;
        snap: root.snap;
        selected-count: root.selected-count;
        merge-blocked-because: root.merge-blocked-because;
        has-av-tools: root.has-av-tools;
        playhead: root.playhead;
        frame-rate: root.frame-rate;
        scroll-left: root.scroll-left;
        seconds-per-pixel: root.seconds-per-pixel;

        tab-selected(index) => { root.tab-selected(index); }
        tab-renamed(index, name) => { root.tab-renamed(index, name); }
        tab-close-requested(index) => { root.tab-close-requested(index); }
        tab-added => { root.tab-added(); }
        tool-changed(tool) => { root.tool-changed(tool); }
        snap-changed(snap) => { root.snap-changed(snap); }
        split => { root.split(); }
        merge => { root.merge(); }
        delete-selected => { root.delete-selected(); }
        av-tools => { root.av-tools(); }
        av-items: root.av-items;
        av-height: root.av-height;
        av-token: root.av-token;
        av-selected(id) => { root.av-selected(id); }
        add-track => { root.add-track(); }
        zoom-to-fit(width) => { root.zoom-to-fit(width); }
        zoom(factor, anchor) => { root.zoom(factor, anchor); }
        scrubbed(seconds) => { root.scrubbed(seconds); }
        clip-pressed(id, additive, edge) => { root.clip-pressed(id, additive, edge); }
        clip-dragged(seconds, pixels) => { root.clip-dragged(seconds, pixels); }
        clip-released => { root.clip-released(); }
        razored(id, seconds) => { root.razored(id, seconds); }
        menu-items: root.menu-items;
        menu-height: root.menu-height;
        menu-token: root.menu-token;
        clip-context(id) => { root.clip-context(id); }
        menu-selected(id) => { root.menu-selected(id); }
        band-selected(a, b, c, d, additive) => { root.band-selected(a, b, c, d, additive); }
        scrolled(seconds) => { root.scrolled(seconds); }
        drop: root.drop;
        drag-hovered(payload, seconds, row) => {
            root.drag-hovered(payload, seconds, row);
        }
        dropped(payload, seconds, row) => { root.dropped(payload, seconds, row); }
        track-flag-changed(index, visible, muted, locked) => {
            root.track-flag-changed(index, visible, muted, locked);
        }
        track-sized(index, size) => { root.track-sized(index, size); }
        track-removed(index) => { root.track-removed(index); }
        track-renamed(index, name) => { root.track-renamed(index, name); }
    }

    // Media | Preview: the drag moves Media's edge, Preview absorbs it.
    ColSplitter {
        x: root.gap + root.media-w;
        y: root.gap;
        width: root.gap;
        height: root.top-h;

        pressed => { root.press-share = root.media-share; }
        moved(delta) => {
            root.media-share = root.fit(root.press-share + delta / root.track-w,
                root.min-col / root.track-w,
                1 - (root.config-w + root.min-col) / root.track-w);
        }
    }

    // Preview | Config: the same drag the other way round, since it is
    // Config's leading edge that moves.
    ColSplitter {
        x: 2 * root.gap + root.media-w + root.preview-w;
        y: root.gap;
        width: root.gap;
        height: root.top-h;

        pressed => { root.press-share = root.config-share; }
        moved(delta) => {
            root.config-share = root.fit(root.press-share - delta / root.track-w,
                root.min-config / root.track-w,
                1 - (root.media-w + root.min-col) / root.track-w);
        }
    }

    // Top row | Timeline.
    RowSplitter {
        x: root.gap;
        y: root.gap + root.top-h;
        width: root.width - 2 * root.gap;
        height: root.gap;

        pressed => { root.press-share = root.top-share; }
        moved(delta) => {
            root.top-share = root.fit(root.press-share + delta / root.track-h,
                root.min-row / root.track-h,
                1 - root.min-row / root.track-h);
        }
    }
}
