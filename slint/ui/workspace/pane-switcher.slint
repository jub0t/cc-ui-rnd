import { Theme } from "../theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Payload } from "../util.slint";
import { Tip } from "../primitives/tooltip.slint";

// Which editor a seat is showing, and the control that changes it.
//
// Blender's model, reduced to the part that earns its keep. There, every area
// carries an editor-type dropdown in its corner and any editor can be put in
// any area; areas can also be split and joined by dragging their corners. The
// dropdown is the half that changes how the window is used day to day — it is
// what lets someone who lives in the timeline give it the whole top of the
// screen — and it is the half that does not need a new layout engine.
//
// A view can be up in more than one seat at once, as it can in Blender. Each
// seat builds its own instance, and they all read the same Editor global — so
// two monitors show one playhead and two libraries show one bin, while each
// keeps its own local state: which catalogue page is open, how wide its
// sidebar is, where it is scrolled to. Picking is an assignment and nothing
// else; nothing is taken away from anywhere.
//
// The corollary is that a view can also be absent — set all four seats to the
// library and there is no timeline on screen. That is the user's business, and
// the state it was showing is untouched: it is in the global, not in the pane
// that was drawing it.
export enum PaneKind {
    /// the bin and the catalogues
    media,
    /// the monitor
    preview,
    /// details, adjust, text, the preset stacks
    inspector,
    /// tabs, tray, lanes
    timeline,
}

export global Panes {
    public pure function label(kind: PaneKind) -> string {
        return kind == PaneKind.media ? "Library"
            : kind == PaneKind.preview ? "Preview"
            : kind == PaneKind.inspector ? "Inspector"
            : "Timeline";
    }

    /// The name a view goes by in a drag payload — stable, lower-case, and
    /// the same string Rust matches on to draw the chip under the cursor.
    /// Not the label: that is prose and could be translated tomorrow.
    public pure function id(kind: PaneKind) -> string {
        return kind == PaneKind.media ? "media"
            : kind == PaneKind.preview ? "preview"
            : kind == PaneKind.inspector ? "inspector"
            : "timeline";
    }

    /// The mark a view is known by, and the one the corner button wears.
    /// Chosen to be tellable apart at 13px rather than to be the most literal
    /// picture of each: a strip of film, a still frame, the inspector's own
    /// sliders, and a stack of lanes.
    public pure function glyph(kind: PaneKind) -> Glyph {
        return kind == PaneKind.media ? Glyph.film
            : kind == PaneKind.preview ? Glyph.image
            : kind == PaneKind.inspector ? Glyph.settings
            : Glyph.rows;
    }
}

// One row of the dropdown: the view's mark, its name, and a tick on the one
// that is already here.
component SwitchRow inherits Rectangle {
    in property <PaneKind> kind;
    in property <bool> current;

    callback chosen();

    height: 26px;

    Rectangle {
        x: 4px;
        y: 0;
        width: parent.width - 8px;
        height: parent.height;
        border-radius: Theme.r-xs;
        background: touch.has-hover ? Theme.field : Colors.transparent;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Icon {
                    glyph: Panes.glyph(root.kind);
                    size: 13px;
                    tint: root.current ? Theme.accent : Theme.fg-muted;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: Panes.label(root.kind);
                color: root.current ? Theme.fg : Theme.fg-muted;
                font-size: Theme.fs;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.current: VerticalLayout {
                alignment: center;
                Icon {
                    glyph: Glyph.check;
                    size: 12px;
                    tint: Theme.accent;
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.chosen(); }
        }
    }
}

// The button in a pane's top-right corner: the mark of what this pane is
// currently showing, and the two ways to change it.
//
// Click it and a list drops down — pick a view and this seat shows it. Drag it
// onto another seat and the two trade places, which is the same operation said
// with the pointer: it answers "put this *there*" without having to work out
// which of the four boxes "there" is and then name the view that is in it.
// Blender's corner drag does the same job; a browser's tab strip is the other
// place everyone has already learnt it.
export component PaneSwitcher inherits Rectangle {
    /// What this pane is right now.
    in property <PaneKind> kind;
    /// Which of the workspace's boxes it is in, so a drop knows where it came
    /// from. See the payload below.
    in property <int> seat;

    callback picked(kind: PaneKind);

    /// `pane:<seat>:<name>:<slug>` — the seat for the drop, the name for the
    /// chip under the cursor, and the slug for the mark on it.
    property <string> payload:
        "pane:\{root.seat}:\{Panes.label(root.kind)}:\{Panes.id(root.kind)}";

    property <length> menu-w: 168px;
    /// Four rows and the surface's own padding.
    property <length> menu-h: 4 * 26px + 8px;

    // The mark, a gap, and the chevron, with even padding either side.
    property <length> mark: 14px;
    property <length> caret: 10px;
    property <length> pad: 6px;

    width: 2 * root.pad + root.mark + 3px + root.caret;
    height: 24px;

    // The drag only starts once the press has travelled past the threshold,
    // so the TouchArea inside keeps its click and the menu still opens — the
    // same arrangement the bin's cards use.
    drag := DragArea {
        // Move, not copy: a panel is somewhere, and dropping it somewhere else
        // is where it now is.
        allow-move: true;
        data: Payload.of(root.payload);
        drag-image: Payload.preview(root.payload);
        drag-image-offset-x: -8;
        drag-image-offset-y: -4;

        chip := Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: Theme.r-xs;
            // Filled at rest, unlike every other icon button in this window,
            // which idles transparent and only takes a ground when the pointer
            // finds it. Those are actions, and a tray of them wants to read as a
            // row of marks; this one is a *state*, and the one control in the pane
            // that says what the pane is. Blender does the same and for the same
            // reason — its editor-type button is a raised well in a header of flat
            // ones — and it is the only way to find the thing without knowing
            // already that it is there.
            background: touch.pressed ? Theme.field-active
                : touch.has-hover ? Theme.field-hover
                : Theme.field;

            animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

            Icon {
                x: root.pad;
                y: (parent.height - self.height) / 2;
                glyph: Panes.glyph(root.kind);
                size: root.mark;
                tint: touch.has-hover ? Theme.fg : Theme.fg-muted;
            }

            // The chevron: what says this is a picker and not a button that does
            // something. Dimmer than the mark beside it, because the mark is the
            // answer and this is only the invitation to change it.
            Icon {
                x: parent.width - root.pad - self.width;
                y: (parent.height - self.height) / 2;
                glyph: Glyph.chevron-down;
                size: root.caret;
                // Heavier than the set's own weight, because it is drawn smaller
                // than anything else in the window: at 1.9 on a 10-unit glyph the
                // stroke is under a pixel and the chevron greys out to a smudge.
                weight: 2.6;
                tint: touch.has-hover ? Theme.fg-muted : Theme.fg-dim;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { menu.show(); }
            }

            Tip {
                text: "Change what this panel shows, or drag it onto another";
                active: touch.has-hover;
            }
        }
    }

    // Hung under the button and aligned to its trailing edge, which is also
    // the pane's: this control is always in a top-right corner, so a menu that
    // opened rightwards would open off the pane every time. A PopupWindow is
    // its own layer, so it clears the pane's clip on its own.
    menu := PopupWindow {
        x: root.width - root.menu-w;
        y: root.height + 4px;
        width: root.menu-w;
        height: root.menu-h;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            border-radius: Theme.r;
            clip: true;

            VerticalLayout {
                padding: 4px;
                alignment: start;

                // Written out rather than looped: four is the whole list, and
                // a `for` over it would need the array to exist somewhere the
                // rows could reach, which is more machinery than the rows.
                SwitchRow {
                    kind: PaneKind.media;
                    current: root.kind == PaneKind.media;
                    chosen => { menu.close(); root.picked(PaneKind.media); }
                }
                SwitchRow {
                    kind: PaneKind.preview;
                    current: root.kind == PaneKind.preview;
                    chosen => { menu.close(); root.picked(PaneKind.preview); }
                }
                SwitchRow {
                    kind: PaneKind.inspector;
                    current: root.kind == PaneKind.inspector;
                    chosen => { menu.close(); root.picked(PaneKind.inspector); }
                }
                SwitchRow {
                    kind: PaneKind.timeline;
                    current: root.kind == PaneKind.timeline;
                    chosen => { menu.close(); root.picked(PaneKind.timeline); }
                }
            }
        }
    }
}
