import { Theme, SegmentedControl } from "../primitives/primitives.slint";
import { Pane, PaneBody, PaneScroll } from "pane.slint";
import { EffectData } from "../demo/effects-panel.slint";
import {
    AdjustPanel, AppliedPresetData, PresetCatalog, PresetStack,
} from "../inspector/clip-inspector.slint";

// The inspector column, in the legacy app's two states:
//
// - Nothing selected: the Details panel — the project's facts, read-only,
//   with Modify pinned to the foot.
// - Something selected: the clip inspector — Adjust, Filters, Effects —
//   ported from web/src/demo/inspector. The custom-primitives demo panels
//   that used to live here were design inspiration, not something the legacy
//   app carried, so they are gone from the pane (the primitives they proved
//   out live on underneath these controls).

// One fact: muted label left, value right. The value wraps rather than
// elides — a folder path you cannot read is a path you have to go find.
component FactRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    spacing: 12px;
    min-height: 26px;

    Text {
        text: root.label;
        color: Theme.fg-muted;
        font-size: Theme.fs;
        vertical-alignment: center;
    }

    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Theme.fg;
        font-size: Theme.fs;
        horizontal-alignment: right;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

// "PROJECT", "CONTENTS" — the muted caps that break the facts into groups.
component FactHeading inherits HorizontalLayout {
    in property <string> title;

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    padding-top: 10px;
    padding-bottom: 4px;

    Text {
        text: root.title;
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
        font-weight: Theme.weight-title;
        letter-spacing: 1px;
    }
}

export component ConfigPane inherits Rectangle {
    // ── the demo-era seams, kept so main.rs keeps compiling ──────────────
    // The meter/mute machinery has nothing to drive since the demo effects
    // panel left the pane; the properties stay declared because app.slint
    // and main.rs read them for the life of the process. Strip the whole
    // group when the Rust side sheds its demo plumbing.
    in property <[EffectData]> video-effects;
    in property <[EffectData]> audio-effects;
    in property <float> level;
    in property <float> peak;
    out property <bool> muted;
    out property <bool> meter-hovered;
    callback add-effect(audio: bool);
    callback remove-effect(id: int);

    // ── details ──────────────────────────────────────────────────────────
    /// Which of the two states the pane is in.
    in property <bool> has-selection;
    in property <string> project-name: "Untitled project";
    in property <string> project-folder: "—";
    in property <string> project-output: "1080 x 1920";
    in property <string> project-rate: "30.00 fps";
    in property <string> project-duration: "00:00:00:00";
    in property <int> count-media;
    in property <int> count-tracks;
    in property <int> count-clips;

    callback modify-project();

    // ── the clip inspector's chains, owned by Rust ───────────────────────
    in property <[AppliedPresetData]> filters-applied;
    in property <[AppliedPresetData]> effects-applied;

    callback filters-add(preset: AppliedPresetData);
    callback filters-toggle(index: int);
    callback filters-move-by(index: int, delta: int);
    callback filters-remove(index: int);
    callback filters-set-param(index: int, second: bool, value: float);

    callback effects-add(preset: AppliedPresetData);
    callback effects-toggle(index: int);
    callback effects-move-by(index: int, delta: int);
    callback effects-remove(index: int);
    callback effects-set-param(index: int, second: bool, value: float);

    property <int> tab;

    Pane {
        // ── details ──────────────────────────────────────────────────────
        if !root.has-selection: Rectangle {
            height: 48px;

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: Theme.pad;

                Text {
                    text: "DETAILS";
                    color: Theme.fg-muted;
                    font-size: Theme.fs;
                    font-weight: Theme.weight-title;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }
            }
        }

        if !root.has-selection: PaneBody {
            padding: 0px;
            spacing: 0px;

            PaneScroll {
                VerticalLayout {
                    padding-top: 4px;
                    spacing: 2px;

                    FactHeading { title: "PROJECT"; }
                    FactRow { label: "Name"; value: root.project-name; }
                    FactRow { label: "Folder"; value: root.project-folder; }
                    FactRow { label: "Output"; value: root.project-output; }
                    FactRow { label: "Rate"; value: root.project-rate; }
                    FactRow { label: "Duration"; value: root.project-duration; }

                    FactHeading { title: "CONTENTS"; }
                    FactRow { label: "Media"; value: "\{root.count-media}"; }
                    FactRow { label: "Tracks"; value: "\{root.count-tracks}"; }
                    FactRow { label: "Clips"; value: "\{root.count-clips}"; }
                }
            }
        }

        if !root.has-selection: Rectangle {
            height: 49px;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }

            modify := Rectangle {
                x: parent.width - self.width - 10px;
                y: (parent.height - self.height) / 2;
                width: modify-label.width + 28px;
                height: 30px;
                border-radius: Theme.r-sm;
                background: modify-touch.has-hover ? Theme.field-hover : Theme.field;

                animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

                modify-label := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Modify";
                    color: Theme.fg;
                    font-size: Theme.fs;
                    font-weight: Theme.weight-title;
                }

                modify-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.modify-project(); }
                }
            }
        }

        // ── the clip inspector ───────────────────────────────────────────
        if root.has-selection: Rectangle {
            height: 48px;

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;

                VerticalLayout {
                    alignment: center;
                    SegmentedControl {
                        options: ["Adjust", "Filters", "Effects"];
                        current <=> root.tab;
                    }
                }
            }
        }

        if root.has-selection: PaneBody {
            // No padding: the inspector rows carry their own 14px inset, and
            // sections run edge to edge so their hairlines reach both sides.
            padding: 0px;

            PaneScroll {
                if root.tab == 0: AdjustPanel { }

                if root.tab == 1: PresetStack {
                    noun: "filter";
                    library-title: "Filter library";
                    group-labels: PresetCatalog.filter-groups;
                    catalogue: PresetCatalog.filters;
                    applied: root.filters-applied;

                    add(preset) => { root.filters-add(preset); }
                    toggle(index) => { root.filters-toggle(index); }
                    move-by(index, delta) => { root.filters-move-by(index, delta); }
                    remove(index) => { root.filters-remove(index); }
                    set-param(index, second, value) => {
                        root.filters-set-param(index, second, value);
                    }
                }

                if root.tab == 2: PresetStack {
                    noun: "effect";
                    library-title: "Effect library";
                    group-labels: PresetCatalog.effect-groups;
                    catalogue: PresetCatalog.effects;
                    applied: root.effects-applied;

                    add(preset) => { root.effects-add(preset); }
                    toggle(index) => { root.effects-toggle(index); }
                    move-by(index, delta) => { root.effects-move-by(index, delta); }
                    remove(index) => { root.effects-remove(index); }
                    set-param(index, second, value) => {
                        root.effects-set-param(index, second, value);
                    }
                }
            }
        }
    }
}
