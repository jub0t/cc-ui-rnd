import { Theme } from "../theme.slint";

// The inspector shell: a titled surface holding stacked sections.
export component Panel inherits Rectangle {
    in property <string> title;
    in property <string> note;

    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.radius-panel;
    clip: true;

    VerticalLayout {
        alignment: start;

        Rectangle {
            height: 42px;
            HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                alignment: space-between;

                Text {
                    text: root.title;
                    color: Theme.ink;
                    font-size: Theme.text-size;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                Text {
                    text: root.note;
                    color: Theme.ink-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        @children
    }
}

// A titled group of rows, separated from its neighbour by a hairline.
export component Section inherits VerticalLayout {
    in property <string> label;

    Rectangle {
        height: 1px;
        background: Theme.line;
    }

    Rectangle {
        height: 36px;
        background: Theme.head;
        HorizontalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            Text {
                text: root.label;
                color: Theme.ink;
                font-size: Theme.text-size;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }

    VerticalLayout {
        padding: Theme.gutter;
        spacing: Theme.gap;
        @children
    }
}

// Label on the left, control on the right — the inspector's form grammar.
export component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;

    Text {
        width: 78px;
        text: root.label;
        color: Theme.ink-muted;
        font-size: Theme.text-size-sm;
        vertical-alignment: center;
        overflow: elide;
    }

    @children
}
