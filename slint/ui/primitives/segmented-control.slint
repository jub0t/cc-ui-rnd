import { Theme } from "../theme.slint";
import { FocusRing } from "focus-ring.slint";

// Single-select tab row with a thumb that slides to the active segment.
//
// The React version measures each button to place the thumb because the
// segments are `flex: 1 1 0`. Slint lays them out from the same rule, so the
// geometry is computed directly instead of observed.
export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;

    callback changed(index: int);

    property <length> seg-w: (root.width - 4px) / Math.max(root.options.length, 1);

    height: Theme.h;
    min-width: 120px;
    horizontal-stretch: 1;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.r;
    opacity: root.enabled ? 1.0 : 0.45;

    function select(index: int) {
        if (index >= 0 && index < root.options.length) {
            root.current = index;
            root.changed(index);
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.select(Math.mod(root.current + 1, root.options.length));
                return EventResult.accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.select(Math.mod(root.current - 1 + root.options.length, root.options.length));
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    thumb := Rectangle {
        x: 2px + root.current * root.seg-w;
        y: 2px;
        width: root.seg-w;
        height: root.height - 4px;
        border-radius: Theme.r-sm;
        background: Theme.field-hover;

        animate x, width { duration: 180ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }

    for option[index] in root.options: Rectangle {
        x: 2px + index * root.seg-w;
        y: 2px;
        width: root.seg-w;
        height: root.height - 4px;

        Text {
            text: option;
            color: (index == root.current || segment.has-hover) ? Theme.fg : Theme.fg-muted;
            font-size: Theme.fs;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;

            animate color { duration: 140ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
        }

        segment := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                fs.focus();
                root.select(index);
            }
        }
    }

    FocusRing {
        active: fs.has-focus;
        radius: Theme.r;
    }
}
